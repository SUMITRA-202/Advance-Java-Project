<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
         http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!-- ADD EMPLOYEE -->

    <servlet>

        <servlet-name>AddEmployeeServlet</servlet-name>

        <servlet-class>
            com.servlet.AddEmployeeServlet
        </servlet-class>

    </servlet>

    <servlet-mapping>

        <servlet-name>AddEmployeeServlet</servlet-name>

        <url-pattern>/AddEmployeeServlet</url-pattern>

    </servlet-mapping>


    <!-- UPDATE EMPLOYEE -->

    <servlet>

        <servlet-name>UpdateEmployeeServlet</servlet-name>

        <servlet-class>
            com.servlet.UpdateEmployeeServlet
        </servlet-class>

    </servlet>

    <servlet-mapping>

        <servlet-name>UpdateEmployeeServlet</servlet-name>

        <url-pattern>/UpdateEmployeeServlet</url-pattern>

    </servlet-mapping>


    <!-- DELETE EMPLOYEE -->

    <servlet>

        <servlet-name>DeleteEmployeeServlet</servlet-name>

        <servlet-class>
            com.servlet.DeleteEmployeeServlet
        </servlet-class>

    </servlet>

    <servlet-mapping>

        <servlet-name>DeleteEmployeeServlet</servlet-name>

        <url-pattern>/DeleteEmployeeServlet</url-pattern>

    </servlet-mapping>


    <!-- DISPLAY EMPLOYEE -->

    <servlet>

        <servlet-name>DisplayEmployeeServlet</servlet-name>

        <servlet-class>
            com.servlet.DisplayEmployeeServlet
        </servlet-class>

    </servlet>

    <servlet-mapping>

        <servlet-name>DisplayEmployeeServlet</servlet-name>

        <url-pattern>/DisplayEmployeeServlet</url-pattern>

    </servlet-mapping>


    <!-- REPORT SERVLET -->

    <servlet>

        <servlet-name>ReportServlet</servlet-name>

        <servlet-class>
            com.servlet.ReportServlet
        </servlet-class>

    </servlet>

    <servlet-mapping>

        <servlet-name>ReportServlet</servlet-name>

        <url-pattern>/ReportServlet</url-pattern>

    </servlet-mapping>

</web-app>